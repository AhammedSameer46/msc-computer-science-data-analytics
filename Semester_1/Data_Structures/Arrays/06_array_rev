#include <stdio.h>

int main()
{
    int n, a[10], i = 0, j;

    printf("Enter a number: ");
    scanf("%d", &n);

    while (n > 0)
    {
        a[i] = n % 10;
        n = n / 10;
        i++;
    }

    printf("Original number: ");
    for (j = i - 1; j >= 0; j--)
    {
        printf("%d", a[j]);
    }

    printf("\nReversed number: ");
    for (j = 0; j < i; j++)
    {
        printf("%d", a[j]);
    }

    return 0;
}